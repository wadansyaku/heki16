{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heki16-pro",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "dist",
    "run_worker_first": false,
    "not_found_handling": "404-page"
  }
}
